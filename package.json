{
  "name": "subculture-schedule-api",
  "version": "0.1.0",
  "private": true,
  "description": "Electron subculture calendar data API",
  "scripts": {
    "build": "nest build",
    "collect": "node scripts/collector/index.mjs",
    "collect:dry": "node scripts/collector/index.mjs --dry-run",
    "collect:backfill": "node scripts/collector/backfill.mjs",
    "api:pull": "node scripts/api-sync.mjs pull",
    "api:publish": "node scripts/api-sync.mjs push",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "node --test test/collector.test.mjs && jest --config test/jest-e2e.json --runInBand",
    "test:collector": "node --test test/collector.test.mjs",
    "test:e2e": "jest --config test/jest-e2e.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@tesseract.js-data/kor": "^1.0.0",
    "@vercel/blob": "^2.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "electron": "^43.2.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.34.0",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
